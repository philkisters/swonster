rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
      match /games/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == playerId;
        match /steps/{stepId} {
          allow read, write: if request.auth != null && request.auth.uid == playerId;
        }
      }
    }
  }
}
