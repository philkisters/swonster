rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && 'admin' in request.auth.token
             && request.auth.token.admin == true
             && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /configs/{configId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == playerId;
      match /games/{gameId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == playerId);
        allow write: if request.auth != null && request.auth.uid == playerId;
        match /steps/{stepId} {
          allow read, write: if request.auth != null && request.auth.uid == playerId;
        }
      }
    }

    match /{gamePath=**}/games/{gameId} {
      allow read: if isAdmin() || (request.auth != null
                                   && resource.data.status == 'game-over');
    }
  }
}
